# Enable OLED displays
OLED_ENABLE = yes

# Enable RGB matrix (the modern RGB system)
RGB_MATRIX_ENABLE = yes

# Disable old rgblight system (as specified in JSON)
RGBLIGHT_ENABLE = no

# Enable rotary encoders
ENCODER_ENABLE = yes

# Optional: Enable split keyboard support (recommended for Lily58)
SPLIT_KEYBOARD = yes